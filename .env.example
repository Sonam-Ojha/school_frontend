# Laravel API root. Must include the /api prefix.
VITE_API_BASE_URL=http://localhost:8000/api

# Laravel app root (no /api). Used for the Sanctum CSRF cookie endpoint
# when APP auth runs in cookie mode instead of bearer-token mode.
VITE_APP_URL=http://localhost:8000

# 'token'  -> Sanctum personal access token in Authorization header (default, works cross-domain)
# 'cookie' -> Sanctum SPA cookie session (requires same-site domains + CSRF)
VITE_AUTH_MODE=token

VITE_APP_NAME=School ERP
