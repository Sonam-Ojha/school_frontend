# API root. Must end with the /api/v1 prefix the backend serves everything
# under (API_PREFIX in the backend's .env).
VITE_API_BASE_URL=http://localhost:8000/api/v1

# API server root, without the prefix. Only read in cookie mode (see below).
VITE_APP_URL=http://localhost:8000

# How the app signs in. The Node.js backend issues bearer tokens, so keep this
# as 'token'. 'cookie' is for a backend with Laravel Sanctum cookie sessions.
VITE_AUTH_MODE=token

VITE_APP_NAME=School ERP

# Development only. 'true' answers every request from the in-memory mock in
# src/mocks/ (no backend needed). 'false' sends requests to VITE_API_BASE_URL,
# i.e. the real API and its MySQL database.
VITE_USE_MOCK_API=true

# Presentation only: to fill in the Super Admin sign-in page, put
#   VITE_DEMO_SUPERADMIN_EMAIL=...
#   VITE_DEMO_SUPERADMIN_PASSWORD=...
# in .env.development.local (read by npm run dev only). A production build
# refuses to run with them set, because they would end up in the JavaScript.
#
# For a server build, see .env.production.example.
