# Settings for a production build. Copy to .env.production, fill in your
# address, then run `npm run build` and upload dist/ to the server.
#
# Everything here ends up inside the built JavaScript, readable by anyone:
# never put a password, key or secret in it.

# The API, ending with the /api/v1 prefix. When the backend serves the app
# itself (FRONTEND_DIST), this is the same address the site is opened on.
VITE_API_BASE_URL=https://erp.example.in/api/v1
VITE_APP_URL=https://erp.example.in

VITE_AUTH_MODE=token

# The product name shown in the title bar, the sidebar and emails.
VITE_APP_NAME=KLIMB School ERP
